{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "ES2021",
      "ES2022.Intl"
    ],
    "types": [
      "vitest/globals",
      "node"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "functions",
    "projects/**/*"
  ]
}
