node_modules
dist
.vite
.DS_Store
.env
# Backups and per-environment variants carry the same secrets as .env itself.
# Keep .env.example (if one is ever added) tracked.
.env.*
!.env.example
supabase/.temp/

# Bytecode from scripts/make-brand-icons.py, the one Python tool in the repo.
__pycache__/

# Giveaway entry lists: real usernames + user ids, never in a public repo.
giveaway-data/

# Agent worktrees: full repo checkouts (341M today), each with its own node_modules.
# Only this subdirectory: .claude/launch.json and settings.local.json stay tracked.
.claude/worktrees/

# wrangler pages dev scratch (local Pages emulation for _redirects/404 checks)
.wrangler

# Scratch helpers kept in the working tree, never committed. .tmp-q.mjs is an ad-hoc psql
# substitute that reads SUPABASE_DB_URL out of .env; it holds no secret itself, but nothing
# named .tmp-* is meant to be part of the repo, and `git add -A` will take it otherwise.
.tmp-*
