{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "sweep-tmp",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5193", "--strictPort"],
      "env": { "SWEEP": "true", "VITE_SUPABASE_URL": "http://127.0.0.1:54321", "VITE_SUPABASE_ANON_KEY": "sweep-anon-key", "VITE_VAPID_PUBLIC_KEY": "sweep-vapid-key" },
      "port": 5193
    },
    {
      "name": "redesign-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../fun-redesign",
        "run",
        "dev",
        "--",
        "--host",
        "--port",
        "5190"
      ],
      "port": 5190
    },
    {
      "name": "vite-dev-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--host"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "vite-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173"
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "wrangler-pages",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler@3",
        "pages",
        "dev",
        "dist",
        "--port",
        "8788"
      ],
      "port": 8788
    }
  ]
}
