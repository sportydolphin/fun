#!/bin/sh
# The house rules on the staged files only: a second or two here instead of a red `check` after
# the push. It reads the working tree, so a file staged in part is checked whole; the full test
# in CI is still the gate. `git commit --no-verify` skips it.
[ -n "$CI" ] && exit 0
[ -d node_modules ] || exit 0
exec node scripts/house-rules.mjs --staged
