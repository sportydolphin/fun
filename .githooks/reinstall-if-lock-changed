#!/bin/sh
# Shared by post-checkout and post-merge: when package-lock.json differs between the commit we
# left ($1) and the one we landed on ($2), node_modules no longer matches it. A checkout that
# brought in a new dependency (flag-icons, Nov 2026) left Vite failing on a missing import until
# someone reinstalled and restarted it.
#
# `npm ci`, not `npm install`: an install on Windows rewrites the lockfile (the @emnapi trap in
# CLAUDE.md), and a hook must never leave a diff behind. Set SKIP_REINSTALL=1 to turn it off.

old=$1
new=$2

[ -n "$SKIP_REINSTALL" ] && exit 0
[ "$old" = "$new" ] && exit 0
# A fresh clone or `git worktree add` passes the null commit. Nothing was installed there yet,
# so there is nothing stale; installing would only make creating a worktree slow.
case "$old" in *[!0]*) ;; *) exit 0 ;; esac
[ -d node_modules ] || exit 0
git diff --quiet "$old" "$new" -- package-lock.json && exit 0

echo "package-lock.json changed: running npm ci (SKIP_REINSTALL=1 skips this)"
if ! npm ci --no-audit --no-fund; then
  echo "npm ci failed; run it by hand (a running dev server can hold files open on Windows)" >&2
fi
# A hook's exit code cannot undo the checkout, so a failed install only warns.
exit 0
