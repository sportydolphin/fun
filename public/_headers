# Cloudflare Pages response headers.
#
# A file with no rule here leaves Pages as `max-age=0, must-revalidate`, and the zone's Browser
# Cache TTL (4 hours, the plan default) raises that to `max-age=14400` for static file types,
# hashed or not. Past that window a returning visitor revalidates the entry chunk, the font and
# every portrait: a round trip each, on a connection where round trips are the expensive part.
# Three quarters of the traffic here is mobile, so that default is the wrong trade.
#
# The zone setting only ever RAISES a max-age. A rule above 4 hours works as written; one below it
# (`/sw.js`, `/data/*`) goes out as 4 hours on sportydolphin.fun and as written on pages.dev.
# The zone stays on 4 hours anyway: `photos.sportydolphin.fun` (R2, no Cache-Control of its own)
# gets its only max-age from it, and the service worker is fetched past the HTTP cache regardless.
#
# The rules below split the tree by whether a URL's content can ever change.

# Vite stamps a content hash into every filename under /assets/, so a given URL is
# immutable by construction: a changed file gets a different name. Cache it for a year
# and never revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Same deal for the font: one file, replaced only by a deploy that also changes the CSS
# that references it.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The stable-path image mirrors (see scripts/vite-plugin-wpbl-images.mjs). These URLs
# are NOT hashed, because the Pages function that writes a shared player's og:image has
# to predict them from the player's name, so they can be overwritten in place by a later
# deploy. Cache them hard but not immutably: a week, then a revalidation that is almost
# always a cheap 304. A week also bounds how long an unfurler that caches by URL can keep
# showing the old club after a trade, which is what regenerating the cards changes.
/cards/*
  Cache-Control: public, max-age=604800
/portraits/*
  Cache-Control: public, max-age=604800

# The brand images at the root (scripts/make-brand-icons.py) and robots.txt. Stable paths that
# change only on a rebrand, so a day, not the 4-hour revalidation every visit used to pay. Not a
# week: a new icon should reach a returning visitor within a day.
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/badge-96.png
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/icon-maskable-192.png
  Cache-Control: public, max-age=86400
/icon-maskable-512.png
  Cache-Control: public, max-age=86400
/icon.svg
  Cache-Control: public, max-age=86400
/logo-mark.png
  Cache-Control: public, max-age=86400
/logo.png
  Cache-Control: public, max-age=86400
/og-cover.png
  Cache-Control: public, max-age=86400
/play-feature-graphic.png
  Cache-Control: public, max-age=86400
/robots.txt
  Cache-Control: public, max-age=86400

# The open-data download (scripts/vite-plugin-wpbl-data.mjs). Stable paths whose bytes change
# only when the weekly archive commits a correction, so an hour then a revalidation. Readable
# from any origin, since a notebook or someone else's page fetching it is the point.
/data/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# The app shell must not be cached: it is what points at the current hashed asset names,
# so a stale copy pins a returning visitor to a previous deploy's chunks.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Both league sections are the same shell, served by the SPA fallback.
/wpbl
  Cache-Control: public, max-age=0, must-revalidate
/mlb
  Cache-Control: public, max-age=0, must-revalidate

# The service worker: browsers already bypass the HTTP cache for this on update checks,
# but an explicit no-cache keeps an intermediary from pinning an old worker.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Apple's Universal Links association file, the iOS counterpart to assetlinks.json. Two
# things about it are unusual and both are load-bearing:
#
#   1. It has NO file extension, by Apple's spec, so Pages has no mime type to infer and
#      would serve it as application/octet-stream. iOS rejects the file outright at any
#      other content type, silently: links just keep opening in Safari.
#   2. Apple's CDN fetches it directly and does NOT follow redirects, which is the same
#      shape of trap that emptied the offline precache when Pages canonicalised
#      /offline.html to /offline. Verify against the deployed URL, never `npm run dev`.
#
# See docs/IOS.md.
/.well-known/apple-app-site-association
  Content-Type: application/json
