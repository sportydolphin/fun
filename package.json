{
  "name": "sportydolphin-fun",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "knip": "knip --no-progress",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit -p .",
    "bots": "node scripts/run-bots.mjs",
    "payrolls": "node scripts/update-payrolls.mjs",
    "reminders": "node scripts/send-reminders.mjs",
    "streaks": "node scripts/update-streaks.mjs",
    "milestones": "node scripts/update-milestones.mjs",
    "pred-boards": "node scripts/update-prediction-boards.mjs",
    "survivor": "node scripts/resolve-survivor.mjs",
    "survivor-bots": "node scripts/run-survivor-bots.mjs",
    "tasks": "node --env-file=.env scripts/pull-tasks.mjs",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "auth-link": "node --env-file=.env scripts/dev-auth-link.mjs",
    "discord-recaps": "esbuild scripts/post-wpbl-discord-recaps.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/wpbl-discord-recaps.mjs && node node_modules/.cache/wpbl-discord-recaps.mjs",
    "discord-highlights": "node scripts/post-wpbl-discord-highlights.mjs",
    "discord-birthdays": "esbuild scripts/post-wpbl-discord-birthdays.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/wpbl-discord-birthdays.mjs && node node_modules/.cache/wpbl-discord-birthdays.mjs",
    "recaps-sync": "esbuild scripts/sync-wpbl-recaps.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/wpbl-recaps-sync.mjs && node --env-file-if-exists=.env node_modules/.cache/wpbl-recaps-sync.mjs",
    "substack-sync": "esbuild scripts/sync-wpbl-substack.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/wpbl-substack-sync.mjs && node node_modules/.cache/wpbl-substack-sync.mjs",
    "discord-commands": "node --env-file=.env scripts/register-wpbl-discord-commands.mjs",
    "giveaway": "node --env-file=.env scripts/draw-discord-giveaway.mjs",
    "birthdays": "node --env-file=.env scripts/ingest-wpbl-birthdays.mjs",
    "check-functions": "esbuild \"functions/**/*.ts\" --bundle --format=esm --platform=neutral --outdir=node_modules/.cache/functions-check",
    "sitemap": "esbuild scripts/build-sitemap.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/build-sitemap.mjs && node --env-file-if-exists=.env node_modules/.cache/build-sitemap.mjs",
    "subset-font": "node scripts/subset-inter.mjs",
    "validate-pbp": "node --env-file=.env scripts/validate-wpbl-pbp.mjs",
    "check-drift": "node --env-file=.env scripts/check-wpbl-drift.mjs",
    "check-retro": "node --env-file=.env scripts/check-wpbl-retro-stats.mjs",
    "check-roster-forks": "node --env-file=.env scripts/check-wpbl-roster-forks.mjs",
    "fill-play-gaps": "node --env-file=.env scripts/fill-wpbl-play-gaps.mjs",
    "archive": "esbuild scripts/export-wpbl-archive.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/wpbl-archive.mjs && node --env-file-if-exists=.env node_modules/.cache/wpbl-archive.mjs",
    "run-environment": "esbuild scripts/compute-wpbl-run-environment.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/wpbl-run-environment.mjs && node --env-file-if-exists=.env node_modules/.cache/wpbl-run-environment.mjs",
    "check-postseason": "esbuild scripts/check-wpbl-postseason.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/wpbl-check-postseason.mjs && node --env-file-if-exists=.env node_modules/.cache/wpbl-check-postseason.mjs",
    "restock-watch": "node --env-file=.env scripts/watch-wpbl-restock.mjs",
    "commons-sync": "node --env-file=.env scripts/sync-wpbl-commons.mjs",
    "prepare-fan-photos": "python scripts/prepare-fan-photos.py",
    "ingest-fan-photos": "node --env-file=.env scripts/ingest-fan-photos.mjs",
    "site-calendar": "node --env-file=.env scripts/sync-wpbl-site-calendar.mjs",
    "listen-tracking": "node --env-file=.env scripts/listen-wpbl-tracking.mjs",
    "tracking-watch": "node --env-file=.env scripts/watch-wpbl-tracking.mjs",
    "retro-sync": "node --env-file=.env scripts/sync-wpbl-retro.mjs",
    "mentions-watch": "node --env-file=.env scripts/watch-wpbl-mentions.mjs",
    "bluesky-recaps": "esbuild scripts/post-wpbl-bluesky-recaps.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/wpbl-bluesky-recaps.mjs && node --env-file-if-exists=.env node_modules/.cache/wpbl-bluesky-recaps.mjs",
    "bluesky-game-start": "esbuild scripts/post-wpbl-bluesky-game-start.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/wpbl-bluesky-game-start.mjs && node --env-file-if-exists=.env node_modules/.cache/wpbl-bluesky-game-start.mjs",
    "visual": "esbuild scripts/make-visual.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/make-visual.mjs && node --env-file-if-exists=.env node_modules/.cache/make-visual.mjs",
    "sweep": "node scripts/layout-sweep.mjs",
    "sweep:record": "node scripts/layout-sweep.mjs --record --shift"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@supabase/auth-js": "^2.117.3",
    "@supabase/postgrest-js": "^2.117.3",
    "@supabase/realtime-js": "^2.117.3",
    "@supabase/supabase-js": "^2.117.3",
    "html2canvas": "^1.4.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-image-crop": "^11.1.2",
    "web-vitals": "^6.2.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws4fetch": "^1.0.20",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "playwright-core": "^1.64.0",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
